# .gitignore
# Dependencies
node_modules/
/.pnp
.pnp.js

# Testing
/coverage

# Production
/build
/dist

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.idea/
.vscode/
*.swp
*.swo

# Local agent notes (untracked)
CLAUDE.local.md

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Training data
/data/

# Training run logs (checkpoints are committed under public/models/, logs are not)
training/*.log
training/**/*.log

# Playwright MCP cache
.playwright-mcp/

# Python
__pycache__/
*.pyc
training/*.pt
training/**/*.pt
training/*.onnx
training/**/*.onnx
training/.venv/

# Cache directories
.cache/
.parcel-cache/
.vercel

# Large tarballs
*.tgz

# Deployment artifacts
.deployed-checkpoint
.current-version

# Screenshots
*.png

# Harness scheduled-tasks lock (ephemeral per-session state)
.claude/scheduled_tasks.lock
src/games/catan/engine/_mcts_champion.js

# ONNX external-data sidecar files
*.onnx.data
